/*
===========================================================
NPC SPAWN SYSTEM
Version: 1.0.1

HOOK: LIBRARY

WHAT YOU EDIT:
Only edit the SPAWN_CONFIG section below.

Each location has:
- name
- aliases
- firstEntryChance
- revisitChance
- charactersPerSpawn
- characters

IMPORTANT:
- The location "name" is automatically treated as a trigger.
- Add aliases for other ways the player may refer to the same place.
- Chances are percentages from 0 to 100.
- Character numbers are RELATIVE WEIGHTS, not percentages.
- charactersPerSpawn = 1 means one NPC is selected.
- charactersPerSpawn = 2 means two different NPCs can be selected.
===========================================================
*/


/* ========================================================
   CREATOR CONFIGURATION
   ======================================================== */

const SPAWN_CONFIG = {

  /*
  ----------------------------------------------------------
  GENERAL SETTINGS
  ----------------------------------------------------------
  */

  debug: false,

  /*
  Number of turns during which a recently seen character
  is protected from being automatically spawned somewhere
  else.

  Example:
  3 = the character will normally not be auto-spawned
  at another location for the next 3 turns.
  */

  continuityLockTurns: 3,

  /*
  If true, when a character is selected, the engine tries
  to find that character's existing Story Card and inject
  its entry into the generation context.

  This means you do NOT have to duplicate the character's
  full description inside this system.
  */

  injectSelectedStoryCards: true,

  /*
  Maximum number of characters from a Story Card that will
  be injected for one selected NPC.

  This prevents an unusually large Story Card from flooding
  the generation context.
  */

  maxStoryCardCharsPerCharacter: 900,


  /*
  ----------------------------------------------------------
  LOCATIONS
  ----------------------------------------------------------

  COPY ONE COMPLETE LOCATION OBJECT if you want to add
  another location.

  Paste the copy BELOW the previous location object and
  change its values.

  ONLY CHANGE:
  1. name
  2. aliases
  3. firstEntryChance
  4. revisitChance
  5. charactersPerSpawn
  6. characters
  ----------------------------------------------------------
  */

  locations: [

    /*
    ========================================================
    DEMO LOCATION
    ========================================================

    This is the only pre-made example.

    It is fully functional and can be used to test whether
    the system is working correctly.
    ========================================================
    */

    {
      name: "Lantern & Fox Inn",

      aliases: [
        "the Lantern & Fox Inn",
        "the Lantern and Fox",
        "Lantern and Fox Inn",
        "the inn",
        "the tavern"
      ],

      /*
      Chance when the player enters this location for the
      FIRST TIME.
      */

      firstEntryChance: 70,

      /*
      Chance when the player returns to this location
      AFTER having visited it before.
      */

      revisitChance: 25,

      /*
      Maximum number of characters selected in one spawn.

      1 = one NPC
      2 = two different NPCs
      3 = three different NPCs
      */

      charactersPerSpawn: 1,

      /*
      CHARACTER WEIGHTS

      These are RELATIVE WEIGHTS.

      60 / 30 / 10 means roughly:
      Mira = most likely
      Bram = less likely
      Nell = least likely

      The values do NOT need to add up to 100.

      Example:
      6 / 3 / 1 gives approximately the same result as
      60 / 30 / 10.
      */

      characters: {
        "Mira": 60,
        "Bram": 30,
        "Nell": 10
      }
    },


    /*
    ========================================================
    COPY THIS TEMPLATE TO CREATE ANOTHER LOCATION
    ========================================================

    Do not leave "YOUR LOCATION NAME" unchanged.

    Replace every placeholder with your own information.
    ========================================================
    */

    {
      name: "YOUR LOCATION NAME",

      aliases: [
        "another way to name this place",
        "another possible name",
        "a common name for this location"
      ],

      firstEntryChance: 25,

      revisitChance: 10,

      charactersPerSpawn: 1,

      characters: {
        "Character One": 60,
        "Character Two": 30,
        "Character Three": 10
      }
    }

  ]
};


/* ========================================================
   INTERNAL STATE
   ======================================================== */

function NPCSpawn_CreateDefaultState() {

  return {
    initialized: true,

    currentLocation: null,

    visitedLocations: {},

    entryPending: false,

    lastEntry: null,

    pendingSpawn: null,

    recentPresence: {},

    lastProcessedInput: "",

    lastProcessedOutput: ""
  };
}


function NPCSpawn_GetState(state) {

  if (
    !state ||
    typeof state !== "object"
  ) {
    return null;
  }

  if (
    !state.npcSpawn ||
    typeof state.npcSpawn !== "object"
  ) {
    state.npcSpawn =
      NPCSpawn_CreateDefaultState();
  }

  return state.npcSpawn;
}


/* ========================================================
   DEBUG
   ======================================================== */

function NPCSpawn_Debug(message) {

  if (
    SPAWN_CONFIG.debug &&
    typeof console !== "undefined" &&
    console &&
    typeof console.log === "function"
  ) {

    console.log(
      "[NPC Spawn] " +
      String(message)
    );
  }
}


/* ========================================================
   NORMALIZATION
   ======================================================== */

function NPCSpawn_Normalize(value) {

  return String(
    value || ""
  )
    .toLowerCase()
    .normalize("NFD")
    .replace(
      /[\u0300-\u036f]/g,
      ""
    )
    .replace(
      /[“”"']/g,
      ""
    )
    .replace(
      /[^a-z0-9áéíóúüñ&]+/gi,
      " "
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim();
}


/* ========================================================
   NUMBER HELPERS
   ======================================================== */

function NPCSpawn_ClampChance(value) {

  const number =
    Number(value);

  if (
    !Number.isFinite(number)
  ) {
    return 0;
  }

  return Math.max(
    0,
    Math.min(
      100,
      number
    )
  );
}


function NPCSpawn_ClampCount(value) {

  const number =
    Math.floor(
      Number(value)
    );

  if (
    !Number.isFinite(number) ||
    number < 1
  ) {
    return 1;
  }

  return number;
}


/* ========================================================
   CONFIG VALIDATION
   ======================================================== */

function NPCSpawn_IsPlaceholder(value) {

  const source =
    String(
      value || ""
    )
      .toLowerCase()
      .trim();

  if (!source) {
    return true;
  }

  if (
    source.indexOf(
      "your location name"
    ) !== -1
  ) {
    return true;
  }

  if (
    source.indexOf(
      "another way to name this place"
    ) !== -1
  ) {
    return true;
  }

  if (
    source.indexOf(
      "another possible name"
    ) !== -1
  ) {
    return true;
  }

  if (
    source.indexOf(
      "a common name for this location"
    ) !== -1
  ) {
    return true;
  }

  if (
    source.indexOf(
      "character one"
    ) !== -1
  ) {
    return true;
  }

  if (
    source.indexOf(
      "character two"
    ) !== -1
  ) {
    return true;
  }

  if (
    source.indexOf(
      "character three"
    ) !== -1
  ) {
    return true;
  }

  return false;
}


function NPCSpawn_ValidateLocation(location) {

  if (
    !location ||
    typeof location !== "object"
  ) {
    return false;
  }

  if (
    NPCSpawn_IsPlaceholder(
      location.name
    )
  ) {
    return false;
  }

  if (
    !Array.isArray(
      location.characters
    ) &&
    (
      !location.characters ||
      typeof location.characters !== "object"
    )
  ) {
    return false;
  }

  return true;
}


/* ========================================================
   LOCATION HELPERS
   ======================================================== */

function NPCSpawn_GetValidLocations() {

  const locations =
    Array.isArray(
      SPAWN_CONFIG.locations
    )
      ? SPAWN_CONFIG.locations
      : [];

  const result = [];

  for (
    const location
    of locations
  ) {

    if (
      NPCSpawn_ValidateLocation(
        location
      )
    ) {

      result.push(
        location
      );
    }
  }

  return result;
}


function NPCSpawn_GetLocationByName(
  name
) {

  const target =
    NPCSpawn_Normalize(
      name
    );

  if (!target) {
    return null;
  }

  const locations =
    NPCSpawn_GetValidLocations();

  for (
    const location
    of locations
  ) {

    if (
      NPCSpawn_Normalize(
        location.name
      ) === target
    ) {

      return location;
    }
  }

  return null;
}


function NPCSpawn_GetAliases(
  location
) {

  const result = [];

  if (
    location &&
    location.name
  ) {

    result.push(
      NPCSpawn_Normalize(
        location.name
      )
    );
  }

  if (
    location &&
    Array.isArray(
      location.aliases
    )
  ) {

    for (
      const alias
      of location.aliases
    ) {

      const normalized =
        NPCSpawn_Normalize(
          alias
        );

      if (
        normalized &&
        result.indexOf(
          normalized
        ) === -1
      ) {

        result.push(
          normalized
        );
      }
    }
  }

  return result;
}


/* ========================================================
   REGEX ESCAPING
   ======================================================== */

/*
IMPORTANT FIX:
This is the normal JavaScript regex syntax.

The previous version could become invalid if the square
brackets were converted into HTML entities.
*/

function NPCSpawn_EscapeRegExp(
  value
) {

  return String(
    value || ""
  ).replace(
    /[.*+?^${}()|[\]\\]/g,
    "\\$&"
  );
}


/* ========================================================
   PHRASE MATCHING
   ======================================================== */

function NPCSpawn_ContainsPhrase(
  source,
  target
) {

  const normalizedSource =
    NPCSpawn_Normalize(
      source
    );

  const normalizedTarget =
    NPCSpawn_Normalize(
      target
    );

  if (
    !normalizedSource ||
    !normalizedTarget
  ) {
    return false;
  }

  const pattern =
    new RegExp(
      "(^|[^a-z0-9])" +
      NPCSpawn_EscapeRegExp(
        normalizedTarget
      ) +
      "($|[^a-z0-9])",
      "i"
    );

  return pattern.test(
    normalizedSource
  );
}


/* ========================================================
   LOCATION MATCHING
   ======================================================== */

function NPCSpawn_FindLocationMatches(
  text
) {

  const source =
    NPCSpawn_Normalize(
      text
    );

  if (!source) {
    return [];
  }

  const matches = [];

  const locations =
    NPCSpawn_GetValidLocations();

  for (
    const location
    of locations
  ) {

    const aliases =
      NPCSpawn_GetAliases(
        location
      );

    for (
      const alias
      of aliases
    ) {

      if (
        source.indexOf(
          alias
        ) !== -1
      ) {

        matches.push(
          {
            location,
            alias,
            index:
              source.indexOf(
                alias
              )
          }
        );

        break;
      }
    }
  }

  return matches;
}


/* ========================================================
   MOVEMENT DETECTION
   ======================================================== */

/*
IMPORTANT FIX:
The old multiline regex literal was invalid JavaScript.

This version keeps the same idea but places the regex on
one line so JavaScript can parse it correctly.
*/

function NPCSpawn_HasLocationCue(
  source,
  index,
  aliasLength
) {

  const start =
    Math.max(
      0,
      index - 100
    );

  const end =
    Math.min(
      source.length,
      index +
        aliasLength +
        100
    );

  const windowText =
    source.slice(
      start,
      end
    );

  const movementPattern =
    /\b(go|goes|went|going|walk|walks|walked|walking|enter|enters|entered|entering|head|heads|headed|heading|return|returns|returned|returning|arrive|arrives|arrived|arriving|reach|reaches|reached|reaching|travel|travels|traveled|travelling|move|moves|moved|moving|leave|leaves|left|leaving|depart|departs|departed|departing|visit|visits|visited|visiting|back to|into|inside|outside|at|near|ir|voy|va|vamos|fui|ir a|entrar|entro|entra|entrar en|volver|vuelvo|vuelve|volver a|llegar|llego|llega|llegar a|visitar|visito|visita|hacia|dentro|salir|salgo|sale|saliendo)\b/i;

  if (
    movementPattern.test(
      windowText
    )
  ) {

    return true;
  }

  if (
    windowText ===
    source.trim()
  ) {

    return true;
  }

  return false;
}


/* ========================================================
   DEPARTURE DETECTION
   ======================================================== */

/*
IMPORTANT FIX:
The old multiline regex literal was invalid JavaScript.

Again, the same pattern is kept, but now written as a
valid single-line JavaScript regex.
*/

function NPCSpawn_IsLeavingCurrentLocation(
  text,
  currentLocationName
) {

  if (
    !currentLocationName
  ) {
    return false;
  }

  const source =
    NPCSpawn_Normalize(
      text
    );

  const currentLocation =
    NPCSpawn_GetLocationByName(
      currentLocationName
    );

  if (!currentLocation) {
    return false;
  }

  const aliases =
    NPCSpawn_GetAliases(
      currentLocation
    );

  let mentioned = false;

  for (
    const alias
    of aliases
  ) {

    if (
      source.indexOf(
        alias
      ) !== -1
    ) {

      mentioned = true;
      break;
    }
  }

  if (!mentioned) {
    return false;
  }

  const departurePattern =
    /\b(leave|leaves|left|leaving|exit|exits|exited|departing|depart|departed|salir|salgo|sale|saliendo|marcho|marcharse|me voy)\b/i;

  return departurePattern.test(
    source
  );
}


/* ========================================================
   CURRENT LOCATION
   ======================================================== */

function NPCSpawn_SetCurrentLocation(
  state,
  location,
  turn
) {

  if (
    !state ||
    !location
  ) {
    return false;
  }

  const previousLocation =
    state.currentLocation;

  const sameLocation =
    NPCSpawn_Normalize(
      previousLocation
    ) ===
    NPCSpawn_Normalize(
      location.name
    );

  if (sameLocation) {
    return false;
  }

  const alreadyVisited =
    !!state.visitedLocations[
      location.name
    ];

  state.currentLocation =
    location.name;

  state.visitedLocations[
    location.name
  ] = true;

  state.entryPending = true;

  state.lastEntry = {
    location:
      location.name,

    turn:
      turn,

    type:
      alreadyVisited
        ? "revisit"
        : "first"
  };

  NPCSpawn_Debug(
    "Entered location: " +
    location.name +
    " (" +
    state.lastEntry.type +
    ")"
  );

  return true;
}


/* ========================================================
   LOCATION DETECTION FROM INPUT
   ======================================================== */

function NPCSpawn_DetectLocationFromInput(
  text,
  state,
  turn
) {

  if (
    !state
  ) {
    return null;
  }

  const source =
    NPCSpawn_Normalize(
      text
    );

  if (!source) {
    return null;
  }

  const matches =
    NPCSpawn_FindLocationMatches(
      source
    );

  if (
    matches.length === 0
  ) {
    return null;
  }

  /*
  Prefer the latest location mention in the text.
  */

  let selected =
    matches[0];

  for (
    const match
    of matches
  ) {

    if (
      match.index >=
      selected.index
    ) {

      selected =
        match;
    }
  }

  const currentLocation =
    state.currentLocation;

  if (
    currentLocation &&
    NPCSpawn_IsLeavingCurrentLocation(
      source,
      currentLocation
    )
  ) {

    NPCSpawn_Debug(
      "Detected departure from: " +
      currentLocation
    );
  }

  if (
    NPCSpawn_HasLocationCue(
      source,
      selected.index,
      selected.alias.length
    )
  ) {

    NPCSpawn_SetCurrentLocation(
      state,
      selected.location,
      turn
    );

    return selected.location;
  }

  /*
  If the text itself is just the location name or clearly
  identifies a location, accept it anyway.
  */

  if (
    source ===
    selected.alias
  ) {

    NPCSpawn_SetCurrentLocation(
      state,
      selected.location,
      turn
    );

    return selected.location;
  }

  return null;
}


/* ========================================================
   LOCATION DETECTION FROM HISTORY
   ======================================================== */

function NPCSpawn_DetectLocationFromHistory(
  state,
  history,
  turn
) {

  if (
    !state ||
    !Array.isArray(history)
  ) {
    return null;
  }

  for (
    let index =
      history.length - 1;
    index >= 0;
    index--
  ) {

    const item =
      history[index];

    let text = "";

    if (
      typeof item === "string"
    ) {

      text = item;

    } else if (
      item &&
      typeof item === "object"
    ) {

      if (
        typeof item.text === "string"
      ) {

        text =
          item.text;

      } else if (
        typeof item.content === "string"
      ) {

        text =
          item.content;
      }
    }

    if (!text) {
      continue;
    }

    const location =
      NPCSpawn_DetectLocationFromInput(
        text,
        state,
        turn
      );

    if (location) {
      return location;
    }
  }

  return null;
}


/* ========================================================
   WEIGHTED SELECTION
   ======================================================== */

function NPCSpawn_GetCharacterEntries(
  location
) {

  const result = [];

  if (
    !location ||
    !location.characters ||
    typeof location.characters !== "object"
  ) {
    return result;
  }

  for (
    const name
    of Object.keys(
      location.characters
    )
  ) {

    const weight =
      Number(
        location.characters[name]
      );

    if (
      !NPCSpawn_IsPlaceholder(
        name
      ) &&
      Number.isFinite(
        weight
      ) &&
      weight > 0
    ) {

      result.push(
        {
          name,
          weight
        }
      );
    }
  }

  return result;
}


function NPCSpawn_SelectWeightedCharacter(
  entries,
  excludedNames
) {

  if (
    !Array.isArray(entries) ||
    entries.length === 0
  ) {
    return null;
  }

  const available = [];

  for (
    const entry
    of entries
  ) {

    if (
      !excludedNames ||
      excludedNames.indexOf(
        entry.name
      ) === -1
    ) {

      available.push(
        entry
      );
    }
  }

  if (
    available.length === 0
  ) {
    return null;
  }

  let totalWeight = 0;

  for (
    const entry
    of available
  ) {

    totalWeight +=
      Number(
        entry.weight
      );
  }

  if (
    totalWeight <= 0
  ) {
    return null;
  }

  let roll =
    Math.random() *
    totalWeight;

  for (
    const entry
    of available
  ) {

    roll -=
      Number(
        entry.weight
      );

    if (
      roll <= 0
    ) {

      return entry.name;
    }
  }

  return available[
    available.length - 1
  ].name;
}


/* ========================================================
   CONTINUITY LOCK
   ======================================================== */

function NPCSpawn_IsCharacterLocked(
  state,
  characterName,
  locationName,
  turn
) {

  if (
    !state ||
    !state.recentPresence
  ) {
    return false;
  }

  const record =
    state.recentPresence[
      characterName
    ];

  if (
    !record ||
    !Number.isFinite(
      Number(record.turn)
    )
  ) {
    return false;
  }

  const turnsSinceSeen =
    Number(turn) -
    Number(record.turn);

  if (
    turnsSinceSeen <
    0
  ) {
    return false;
  }

  if (
    turnsSinceSeen >
    Number(
      SPAWN_CONFIG.continuityLockTurns
    )
  ) {
    return false;
  }

  if (
    NPCSpawn_Normalize(
      record.location
    ) ===
    NPCSpawn_Normalize(
      locationName
    )
  ) {
    return false;
  }

  return true;
}


/* ========================================================
   SELECT NPCS
   ======================================================== */

function NPCSpawn_SelectCharacters(
  state,
  location,
  turn
) {

  const entries =
    NPCSpawn_GetCharacterEntries(
      location
    );

  if (
    entries.length === 0
  ) {
    return [];
  }

  const maxCharacters =
    Math.min(
      NPCSpawn_ClampCount(
        location.charactersPerSpawn
      ),
      entries.length
    );

  const selected = [];

  for (
    let count = 0;
    count < maxCharacters;
    count++
  ) {

    const available =
      [];

    for (
      const entry
      of entries
    ) {

      if (
        selected.indexOf(
          entry.name
        ) !== -1
      ) {
        continue;
      }

      if (
        NPCSpawn_IsCharacterLocked(
          state,
          entry.name,
          location.name,
          turn
        )
      ) {
        continue;
      }

      available.push(
        entry
      );
    }

    if (
      available.length === 0
    ) {
      break;
    }

    const chosen =
      NPCSpawn_SelectWeightedCharacter(
        available,
        selected
      );

    if (!chosen) {
      break;
    }

    selected.push(
      chosen
    );
  }

  return selected;
}


/* ========================================================
   SPAWN CHANCE
   ======================================================== */

function NPCSpawn_GetEntryChance(
  state,
  location
) {

  if (
    !state ||
    !location
  ) {
    return 0;
  }

  const firstVisit =
    !state.visitedLocations[
      location.name
    ];

  /*
  Normally this function is called AFTER the location has
  already been marked visited, so use lastEntry.type when
  available.
  */

  if (
    state.lastEntry &&
    NPCSpawn_Normalize(
      state.lastEntry.location
    ) ===
    NPCSpawn_Normalize(
      location.name
    )
  ) {

    if (
      state.lastEntry.type ===
      "first"
    ) {

      return NPCSpawn_ClampChance(
        location.firstEntryChance
      );
    }

    return NPCSpawn_ClampChance(
      location.revisitChance
    );
  }

  if (firstVisit) {

    return NPCSpawn_ClampChance(
      location.firstEntryChance
    );
  }

  return NPCSpawn_ClampChance(
    location.revisitChance
  );
}


/* ========================================================
   STORY CARD HELPERS
   ======================================================== */

function NPCSpawn_GetStoryCardKeyText(
  card
) {

  if (!card) {
    return "";
  }

  if (
    Array.isArray(
      card.keys
    )
  ) {

    return card.keys.join(
      ", "
    );
  }

  if (
    typeof card.keys === "string"
  ) {

    return card.keys;
  }

  if (
    typeof card.key === "string"
  ) {

    return card.key;
  }

  if (
    typeof card.name === "string"
  ) {

    return card.name;
  }

  return "";
}


function NPCSpawn_GetStoryCardEntryText(
  card
) {

  if (!card) {
    return "";
  }

  if (
    typeof card.entry === "string"
  ) {

    return card.entry;
  }

  if (
    typeof card.text === "string"
  ) {

    return card.text;
  }

  if (
    typeof card.content === "string"
  ) {

    return card.content;
  }

  return "";
}


function NPCSpawn_FindStoryCard(
  storyCards,
  characterName
) {

  if (
    !Array.isArray(storyCards)
  ) {
    return null;
  }

  const target =
    NPCSpawn_Normalize(
      characterName
    );

  if (!target) {
    return null;
  }

  for (
    const card
    of storyCards
  ) {

    const keyText =
      NPCSpawn_Normalize(
        NPCSpawn_GetStoryCardKeyText(
          card
        )
      );

    const entryText =
      NPCSpawn_Normalize(
        NPCSpawn_GetStoryCardEntryText(
          card
        )
      );

    if (
      keyText.indexOf(
        target
      ) !== -1
    ) {

      return card;
    }

    if (
      entryText.indexOf(
        target
      ) !== -1
    ) {

      return card;
    }
  }

  return null;
}


function NPCSpawn_TrimStoryCardEntry(
  text,
  maxChars
) {

  const source =
    String(
      text || ""
    );

  const limit =
    Math.max(
      1,
      Number(maxChars) || 900
    );

  if (
    source.length <= limit
  ) {

    return source;
  }

  return (
    source.slice(
      0,
      Math.max(
        0,
        limit - 3
      )
    ) +
    "..."
  );
}


/* ========================================================
   SPAWN GUIDANCE
   ======================================================== */

function NPCSpawn_BuildContextGuidance(
  state,
  selectedCharacters,
  storyCards
) {

  if (
    !state ||
    !state.currentLocation ||
    !Array.isArray(
      selectedCharacters
    ) ||
    selectedCharacters.length === 0
  ) {
    return "";
  }

  let guidance =
    "NPC SPAWN INSTRUCTION: " +
    "Naturally include the following character";

  if (
    selectedCharacters.length !== 1
  ) {

    guidance +=
      "s";
  }

  guidance +=
    " in the current scene at " +
    state.currentLocation +
    ": " +
    selectedCharacters.join(
      ", "
    ) +
    ". " +
    "Do not force unnatural behavior. " +
    "Let the character(s) act according to their established personality, circumstances, and location.";

  if (
    SPAWN_CONFIG.injectSelectedStoryCards &&
    Array.isArray(storyCards)
  ) {

    for (
      const characterName
      of selectedCharacters
    ) {

      const card =
        NPCSpawn_FindStoryCard(
          storyCards,
          characterName
        );

      if (!card) {
        continue;
      }

      const entry =
        NPCSpawn_TrimStoryCardEntry(
          NPCSpawn_GetStoryCardEntryText(
            card
          ),
          SPAWN_CONFIG.maxStoryCardCharsPerCharacter
        );

      if (!entry) {
        continue;
      }

      guidance +=
        "\n\nCHARACTER CONTEXT FOR " +
        characterName +
        ":\n" +
        entry;
    }
  }

  return guidance;
}


/* ========================================================
   HANDLE INPUT
   ======================================================== */

function NPCSpawn_HandleInput(
  text,
  stateRoot,
  history,
  turn
) {

  const state =
    NPCSpawn_GetState(
      stateRoot
    );

  if (!state) {
    return;
  }

  const source =
    String(
      text || ""
    );

  if (
    !source
  ) {
    return;
  }

  if (
    state.lastProcessedInput ===
    source
  ) {
    return;
  }

  state.lastProcessedInput =
    source;

  /*
  Try direct input first.
  */

  NPCSpawn_DetectLocationFromInput(
    source,
    state,
    turn
  );

  /*
  If nothing was detected, look through history.
  This helps when the player's input is very short.
  */

  if (
    !state.currentLocation
  ) {

    NPCSpawn_DetectLocationFromHistory(
      state,
      history,
      turn
    );
  }
}


/* ========================================================
   HANDLE CONTEXT
   ======================================================== */

function NPCSpawn_HandleContext(
  text,
  stateRoot,
  history,
  storyCards,
  turn
) {

  const state =
    NPCSpawn_GetState(
      stateRoot
    );

  if (!state) {
    return "";
  }

  /*
  Do not spawn unless a new location entry is pending.
  */

  if (
    !state.entryPending
  ) {
    return "";
  }

  const location =
    NPCSpawn_GetLocationByName(
      state.currentLocation
    );

  if (!location) {

    state.entryPending =
      false;

    return "";
  }

  const chance =
    NPCSpawn_GetEntryChance(
      state,
      location
    );

  /*
  Consume the entry flag now so the same entry cannot
  repeatedly roll a new spawn during the same generation.
  */

  state.entryPending =
    false;

  if (
    Math.random() * 100 >=
    chance
  ) {

    state.pendingSpawn =
      null;

    NPCSpawn_Debug(
      "No spawn at " +
      location.name +
      " (" +
      chance +
      "% chance)"
    );

    return "";
  }

  const selected =
    NPCSpawn_SelectCharacters(
      state,
      location,
      turn
    );

  if (
    selected.length === 0
  ) {

    state.pendingSpawn =
      null;

    return "";
  }

  state.pendingSpawn = {

    location:
      location.name,

    characters:
      selected.slice(),

    turn:
      turn
  };

  NPCSpawn_Debug(
    "Selected NPCs: " +
    selected.join(
      ", "
    ) +
    " at " +
    location.name
  );

  return NPCSpawn_BuildContextGuidance(
    state,
    selected,
    storyCards
  );
}


/* ========================================================
   HANDLE OUTPUT
   ======================================================== */

function NPCSpawn_HandleOutput(
  text,
  stateRoot,
  history,
  turn
) {

  const state =
    NPCSpawn_GetState(
      stateRoot
    );

  if (!state) {
    return;
  }

  const source =
    String(
      text || ""
    );

  if (
    !source
  ) {
    return;
  }

  if (
    state.lastProcessedOutput ===
    source
  ) {
    return;
  }

  state.lastProcessedOutput =
    source;


  /*
  ----------------------------------------------------------
  FIRST:
  Check whether the generated output mentions a configured
  location.

  This helps maintain location continuity even when the
  player's input itself did not contain the location name.
  ----------------------------------------------------------
  */

  const locationMatches =
    NPCSpawn_FindLocationMatches(
      source
    );

  if (
    locationMatches.length > 0
  ) {

    let selectedLocation =
      locationMatches[0];

    for (
      const match
      of locationMatches
    ) {

      if (
        match.index >=
        selectedLocation.index
      ) {

        selectedLocation =
          match;
      }
    }

    if (
      NPCSpawn_HasLocationCue(
        NPCSpawn_Normalize(
          source
        ),
        selectedLocation.index,
        selectedLocation.alias.length
      )
    ) {

      NPCSpawn_SetCurrentLocation(
        state,
        selectedLocation.location,
        turn
      );
    }
  }


  /*
  ----------------------------------------------------------
  SECOND:
  Check which configured NPC names actually appeared in
  the generated output.

  IMPORTANT:
  Selection does NOT equal presence.

  The NPC is only recorded as present if the generated text
  actually mentions the character.
  ----------------------------------------------------------
  */

  const locations =
    NPCSpawn_GetValidLocations();

  for (
    const location
    of locations
  ) {

    const entries =
      NPCSpawn_GetCharacterEntries(
        location
      );

    for (
      const entry
      of entries
    ) {

      if (
        NPCSpawn_ContainsPhrase(
          source,
          entry.name
        )
      ) {

        state.recentPresence[
          entry.name
        ] = {

          location:
            state.currentLocation ||
            location.name,

          turn:
            turn
        };

        NPCSpawn_Debug(
          "Confirmed presence: " +
          entry.name +
          " at " +
          (
            state.currentLocation ||
            location.name
          )
        );
      }
    }
  }


  /*
  ----------------------------------------------------------
  THIRD:
  Clear the pending selection.

  The selection was already used for this generation.
  Whether it became real in the story was determined above.
  ----------------------------------------------------------
  */

  state.pendingSpawn =
    null;
}


/* ========================================================
   CLEAN OLD CONTINUITY RECORDS
   ======================================================== */

function NPCSpawn_CleanupPresence(
  state,
  turn
) {

  if (
    !state ||
    !state.recentPresence
  ) {
    return;
  }

  const limit =
    Math.max(
      1,
      Number(
        SPAWN_CONFIG.continuityLockTurns
      ) || 3
    );

  for (
    const characterName
    of Object.keys(
      state.recentPresence
    )
  ) {

    const record =
      state.recentPresence[
        characterName
      ];

    if (
      !record
    ) {
      delete state.recentPresence[
        characterName
      ];

      continue;
    }

    if (
      Number(turn) -
      Number(record.turn) >
      limit
    ) {

      delete state.recentPresence[
        characterName
      ];
    }
  }
}


/* ========================================================
   PUBLIC API
   ======================================================== */

const NPCSpawn = {

  handleInput:
    function(
      text,
      state,
      history,
      turn
    ) {

      NPCSpawn_HandleInput(
        text,
        state,
        history,
        turn
      );

      const internalState =
        NPCSpawn_GetState(
          state
        );

      NPCSpawn_CleanupPresence(
        internalState,
        turn
      );
    },


  handleContext:
    function(
      text,
      state,
      history,
      storyCards,
      turn
    ) {

      const internalState =
        NPCSpawn_GetState(
          state
        );

      NPCSpawn_CleanupPresence(
        internalState,
        turn
      );

      return NPCSpawn_HandleContext(
        text,
        state,
        history,
        storyCards,
        turn
      );
    },


  handleOutput:
    function(
      text,
      state,
      history,
      turn
    ) {

      NPCSpawn_HandleOutput(
        text,
        state,
        history,
        turn
      );

      const internalState =
        NPCSpawn_GetState(
          state
        );

      NPCSpawn_CleanupPresence(
        internalState,
        turn
      );
    }

};


